<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Material You. The neutrals are derived from the user's
     wallpaper, so the widget sits with the rest of their home screen; the
     score colour on the bars stays the app's own, because it carries meaning
     a wallpaper hue cannot. The radius is the launcher's, so the widget's
     corners match every other widget on the page. -->
<resources>
    <color name="widget_background">@android:color/system_neutral1_50</color>
    <color name="widget_on_background">@android:color/system_neutral1_900</color>
    <color name="widget_on_background_variant">@android:color/system_neutral2_700</color>
    <dimen name="widget_corner_radius">@android:dimen/system_app_widget_background_radius</dimen>
</resources>
