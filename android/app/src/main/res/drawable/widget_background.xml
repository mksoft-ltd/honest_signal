<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card. Colour and radius come from resources so Android 12+
     can substitute the launcher's own radius and the wallpaper-derived
     (Material You) neutrals; see values-v31/widget_resources.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
